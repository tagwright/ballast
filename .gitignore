/ballast
/dist/
*.exe
*.test
*.out
*.prof

# Local dev
.env
*.local

# Never commit decrypted secrets or a live secrets dir
*.sops.decrypted
/run/
/secrets/

# Generated by the test/integration/*.sh harness scripts; the *.yml configs
# and *.sh scripts are committed, everything else in this tree is throwaway
# per-run state.
/test/integration/repos/
/test/integration/restore/
/test/integration/repos-stream/
/test/integration/restore-stream/
/test/integration/repos-s3/
/test/integration/restore-s3/
/test/integration/secrets/
